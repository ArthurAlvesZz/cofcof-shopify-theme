{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "PROJECT_CONTEXT_COFCOF.md",
    "MIGRATION_RULES_COFCOF.md",
    "ROUTES_TEMPLATES_COFCOF.md"
  ],
  "share": "manual",
  "compaction": {
    "auto": true
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "read": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  }
}
