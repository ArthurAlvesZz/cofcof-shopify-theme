<style>
:root{--black:#0A0A0A;--sand:#F6F1EB;--sand-2:#EFE7DB;--parch:#E8E0D4;--clay:#7A6654;--sub:#6B6B6B;--dim:#999;--rule:rgba(10,10,10,.12);--rule-w:rgba(246,241,235,.14);--fn:'DM Sans',Helvetica,sans-serif;--fl:'Montserrat',sans-serif}
*{box-sizing:border-box}a{color:inherit;text-decoration:none}button{cursor:pointer;border:none;background:none;font:inherit;color:inherit}
.bx{max-width:1340px;margin:0 auto;padding:0 28px}
