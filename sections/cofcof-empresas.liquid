.sg-svg{width:48px;height:48px;margin-bottom:32px;stroke:var(--clay);fill:none;stroke-width:1.3}
.sg-t{font-family:var(--fl);font-weight:800;font-size:22px;text-transform:uppercase;letter-spacing:.02em;margin-bottom:16px}
.sg-d{font-family:var(--fn);font-weight:300;font-size:16px;color:rgba(246,241,235,.7);line-height:1.6;flex:1}
