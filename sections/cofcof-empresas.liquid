.num-v{font-family:var(--fl);font-weight:800;font-size:32px;color:var(--sand);letter-spacing:-.01em;line-height:1}
.num-l{font-family:var(--fl);font-weight:600;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:rgba(246,241,235,.5);margin-top:10px}
.cta-end{background:var(--black);padding:clamp(80px,12vh,140px) 0;text-align:center}
