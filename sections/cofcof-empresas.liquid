.pg-hero-cta{margin-top:56px;display:flex;flex-wrap:wrap;gap:16px}
.tk{background:var(--sand);border-bottom:1px solid var(--rule);padding:16px 0;overflow:hidden;display:flex;align-items:center}
.tk-i{display:flex;white-space:nowrap;animation:emp-tk-scroll 25s linear infinite}
.tk-item{font-family:var(--fl);font-weight:700;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--clay);display:flex;align-items:center;margin-right:48px}
.tk-item span{font-size:8px;margin-left:48px;opacity:.4}
@keyframes emp-tk-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.head{display:flex;flex-direction:column;gap:32px;margin-bottom:64px}
@media(min-width:768px){.head{flex-direction:row;justify-content:space-between;align-items:flex-end}}
.head-meta{color:var(--sub);font-size:11px}
.sec-d .head-meta{color:rgba(246,241,235,.5)}
.sg{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.sg-i{border:1px solid var(--rule-w);padding:clamp(40px,4vw,56px);display:flex;flex-direction:column;transition:background .3s,border-color .3s}
