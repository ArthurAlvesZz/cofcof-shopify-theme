.step{display:flex;flex-direction:column}
.step-n{font-family:var(--fl);font-weight:800;font-size:56px;line-height:1;letter-spacing:-.02em;color:var(--sand);margin-bottom:32px;opacity:.6}
.step h3{font-size:clamp(20px,2vw,24px);color:var(--sand);margin-bottom:16px}
