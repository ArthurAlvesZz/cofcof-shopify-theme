.dif{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px;margin-top:64px}
.dif-i{padding:32px;border:1px solid rgba(246,241,235,.15);background:rgba(246,241,235,.03)}
.dif-n{font-family:var(--fl);font-weight:800;font-size:clamp(48px,6vw,64px);color:var(--sand);margin-bottom:16px;line-height:1}
.dif-t{font-family:var(--fl);font-weight:700;font-size:20px;letter-spacing:.1em;text-transform:uppercase;color:var(--sand);margin-bottom:12px}
.dif-d{font-family:var(--fn);font-weight:300;font-size:15px;color:rgba(246,241,235,.6);line-height:1.6}
.ctab{text-align:center;padding:clamp(48px,6vw,80px) 0;margin-top:32px}
.ctab h3{font-family:var(--fl);font-weight:800;font-size:clamp(28px,3.5vw,40px);color:var(--sand);margin-bottom:24px;line-height:1.15;text-transform:uppercase}
.ctab p{font-size:18px;color:rgba(246,241,235,.7);max-width:600px;margin:0 auto 40px;line-height:1.65}
.exp-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:clamp(40px,8vw,80px);align-items:center;margin-top:40px}
@media(max-width:899px){.exp-grid{grid-template-columns:1fr}}
.exp-text{font-size:18px;line-height:1.7;color:rgba(246,241,235,.85)}
.exp-text p{margin-bottom:24px}
.exp-card{background:var(--sand);color:var(--black);padding:clamp(40px,5vw,64px);border:1px solid var(--rule)}
.exp-card h4{padding-bottom:24px;border-bottom:1px solid var(--rule);font-size:20px;font-weight:800;text-transform:uppercase;margin-bottom:24px}
.exp-card p{font-size:18px;line-height:1.6;font-weight:300;font-family:var(--fn)}
.exp-cta{display:inline-block;margin-top:28px;font-family:var(--fl);font-weight:700;font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--sand);border-bottom:1px solid rgba(246,241,235,.3);padding-bottom:4px}
.num-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin-top:clamp(40px,8vh,64px);border-top:1px solid var(--rule-w)}
@media(min-width:768px){.num-grid{grid-template-columns:repeat(4,1fr)}}
.num-i{padding:36px 24px;border-bottom:1px solid var(--rule-w);border-right:1px solid var(--rule-w);text-align:center}
.num-i:nth-child(2n){border-right:none}
