<script>
document.addEventListener('DOMContentLoaded', function() {
  function scrollToElement(id, offset) {
    var el = document.getElementById(id);
    if (!el) return;
    var y = el.getBoundingClientRect().top + window.scrollY - (offset || 100);
    window.scrollTo({ top: y, behavior: 'smooth' });
  }

  document.querySelectorAll('.idx-i, .lnk[href^="#lote-"]').forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var id = this.getAttribute('href').substring(1);
      scrollToElement(id);
    });
  });

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        e.target.classList.add('v');
        var fills = e.target.querySelectorAll('.cf-bar-fill');
        fills.forEach(function(f) {
          f.style.transform = 'scaleX(' + f.getAttribute('style')?.match(/--w:\s*([\d.]+)/)?.[1] || '1' + ')';
        });
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.fi').forEach(function(el) { observer.observe(el); });
});
</script>

