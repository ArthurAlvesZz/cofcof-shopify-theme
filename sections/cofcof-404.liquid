<section class="cof-404">
  <style>
    .cof-404{--black:#0a0a0a;--sand:#f6f1eb;--muted:rgba(246,241,235,.68);--gold:#c9a263;--line:rgba(246,241,235,.14);font-family:'DM Sans',Helvetica,sans-serif;background:var(--black);color:var(--sand);min-height:100vh}.cof-404 a{color:inherit;text-decoration:none}.cof-404__wrap{max-width:1340px;margin:0 auto;padding:0 28px}@media(min-width:768px){.cof-404__wrap{padding:0 56px}}.cof-404__hero{padding:92px 0 84px;max-width:820px}.cof-404__eyebrow{font:800 11px/1.4 Montserrat,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)}.cof-404 h1{font:800 clamp(42px,8vw,96px)/.9 Montserrat,sans-serif;text-transform:uppercase;margin:24px 0}.cof-404 p{color:var(--muted);font-size:18px;line-height:1.75}.cof-404__actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.cof-404__btn{display:inline-block;padding:17px 26px;border:1px solid var(--sand);color:var(--sand);font:800 11px/1 Montserrat,sans-serif;letter-spacing:.18em;text-transform:uppercase}.cof-404__btn:hover{background:var(--sand);color:var(--black)}.cof-404__btn--fill{background:var(--sand);color:var(--black)}.cof-404__btn--fill:hover{background:transparent;color:var(--sand)}@media(max-width:620px){.cof-404__wrap{padding:0 20px}.cof-404 h1{font-size:42px}.cof-404__actions{display:grid}.cof-404__btn{text-align:center}}
  </style>
  {% render 'cofcof-custom-nav', active: '' %}
  <div class="cof-404__wrap">
    <div class="cof-404__hero">
      <div class="cof-404__eyebrow">Pagina nao encontrada</div>
      <h1>Esse caminho ainda nao esta ativo.</h1>
      <p>O conteudo pode depender de uma pagina criada no Admin Shopify. Enquanto isso, continue pela home, assinatura ou cafes.</p>
      <div class="cof-404__actions">
        <a class="cof-404__btn cof-404__btn--fill" href="{{ routes.root_url }}">Voltar para home</a>
        <a class="cof-404__btn" href="/pages/assinatura">Ver assinatura</a>
        <a class="cof-404__btn" href="/pages/cafes">Ver cafes</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CofCof 404",
  "settings": []
}
{% endschema %}
