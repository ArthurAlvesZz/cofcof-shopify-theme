{% liquid
  assign categories = "Todos,Cafeterias,Empórios,Restaurantes,Padarias,Hotéis,Postos,Conveniência,Revendas" | split: ','

  if section.settings.heading == blank
    assign heading = "Onde encontrar CofCof"
  else
    assign heading = section.settings.heading
  endif

  if section.settings.text == blank
    assign text = "Parceiros sao pontos selecionados. Cada local listado aqui aproxima voce de cafes com origem e frescor."
  else
    assign text = section.settings.text
  endif
%}

<div class="cof-partner-full" data-cof-partner-root>
<style>
.cof-partner-full{--black:#0A0A0A;--sand:#F6F1EB;--clay:#7A6654;--sub:#6B6B6B;--rule-w:rgba(246,241,235,.14);--fn:'DM Sans',Helvetica,sans-serif;--fl:'Montserrat',sans-serif;font-family:var(--fn);color:var(--sand);background:var(--black);position:fixed;inset:0;overflow:hidden;display:flex;flex-direction:column;z-index:0}
.cof-partner-full *{box-sizing:border-box}
.cof-partner-full a{color:inherit;text-decoration:none}
.cof-partner-full input{outline:none;font:inherit}
.cof-partner-full .display{font-family:var(--fl);font-weight:800;text-transform:uppercase;letter-spacing:-.01em;line-height:.96}
.cof-partner-full .body-p{font-family:var(--fn);font-weight:300;line-height:1.65}
.cof-partner-full .label{font-family:var(--fl);font-weight:700;font-size:11px;letter-spacing:.18em;text-transform:uppercase}
.cof-partner-full .btn{position:relative;overflow:hidden;display:inline-block;cursor:pointer;font-family:var(--fl);font-weight:700;letter-spacing:.2em;text-transform:uppercase;transition:color .38s;text-align:center;font-size:10px;padding:16px}
.cof-partner-full .btn>span{position:relative;z-index:1}
.cof-partner-full .btn::before{content:'';position:absolute;inset:0;transform:translateY(101%);transition:transform .42s cubic-bezier(.2,.7,.2,1);z-index:0}
.cof-partner-full .btn:hover::before{transform:translateY(0)}
.cof-partner-full .btn-sd{background:var(--sand);color:var(--black);border:1.5px solid var(--sand)}
.cof-partner-full .btn-sd::before{background:var(--black)}
.cof-partner-full .btn-sd:hover{color:var(--sand)}
.cof-partner-full .btn-gh{border:1px solid var(--rule-w);color:var(--sand)}
.cof-partner-full .btn-gh::before{background:var(--sand)}
.cof-partner-full .btn-gh:hover{color:var(--black)}

/* Split layout */
.cof-partner-full .cp-layout{display:flex;flex:1;overflow:hidden}
.cof-partner-full .cp-panel{width:100%;background:var(--black);border-bottom:1px solid var(--rule-w);display:flex;flex-direction:column;flex-shrink:0}
@media(min-width:768px){.cof-partner-full .cp-panel{width:480px;height:100%;border-right:1px solid var(--rule-w);border-bottom:none}}
.cof-partner-full .cp-header{padding:80px 32px 16px;flex-shrink:0;background:var(--black);z-index:10}
.cof-partner-full .cp-header h1{font-size:32px;margin-bottom:8px}
.cof-partner-full .cp-header p{font-size:14px;color:rgba(246,241,235,.7);margin-bottom:24px}
.cof-partner-full .cp-search{position:relative;margin-bottom:16px}
.cof-partner-full .cp-search input{width:100%;background:var(--black);border:1px solid var(--rule-w);padding:14px 48px;border-radius:4px;color:var(--sand);font-family:var(--fn);font-size:14px}
.cof-partner-full .cp-search svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--sub)}
.cof-partner-full .cp-search .cp-clear{position:absolute;right:16px;top:50%;transform:translateY(-50%);color:var(--sub);background:transparent;border:none;cursor:pointer;padding:4px}
.cof-partner-full .cp-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.cof-partner-full .cp-filters button{padding:6px 12px;border-radius:40px;font-family:var(--fl);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;border:1px solid var(--rule-w);background:var(--black);color:var(--clay);transition:all .2s;cursor:pointer}
.cof-partner-full .cp-filters button.active{background:var(--sand);color:var(--black);border-color:var(--sand)}
.cof-partner-full .cp-filters button span{font-size:8px;background:rgba(0,0,0,.2);padding:2px 4px;border-radius:4px;margin-left:4px}
.cof-partner-full .cp-filters button.active span{background:rgba(255,255,255,.2)}

/* Partner list */
.cof-partner-full .cp-list{flex:1;overflow-y:auto;padding:0 32px 100px;display:flex;flex-direction:column;gap:8px}
.cof-partner-full .cp-card{border:1px solid var(--rule-w);background:var(--black);cursor:pointer;display:flex;flex-direction:column;transition:all .2s}
.cof-partner-full .cp-card:hover,.cof-partner-full .cp-card.active{border-color:var(--sand)}
.cof-partner-full .cp-card-i{display:flex;min-height:130px}
.cof-partner-full .cp-card-img{width:120px;flex-shrink:0;position:relative;background:var(--parch,#E8E0D4)}
.cof-partner-full .cp-card-body{padding:20px;flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center}
.cof-partner-full .cp-card-cat{display:flex;align-items:center;gap:8px;margin-bottom:8px;color:var(--clay);font-size:14px}
.cof-partner-full .cp-card-cat .label{color:var(--clay);font-size:9px}
.cof-partner-full .cp-card h3{font-size:18px;margin-bottom:4px}
.cof-partner-full .cp-card p{font-size:12px;color:var(--sub)}

/* Empty state */
.cof-partner-full .cp-empty{text-align:center;padding:40px 16px;border:1px solid var(--rule-w);background:var(--black)}
.cof-partner-full .cp-empty svg{color:var(--clay);margin:0 auto 16px}
.cof-partner-full .cp-empty h3{font-size:18px;margin-bottom:8px}
.cof-partner-full .cp-empty p{font-size:12px;color:var(--sub);margin-bottom:24px}
.cof-partner-full .cp-empty .btn{display:block;margin-bottom:8px}

/* Map */
.cof-partner-full .cp-map-wrap{flex:1;position:relative;height:45vh}
@media(min-width:768px){.cof-partner-full .cp-map-wrap{height:100%}}

/* Preview */
.cof-partner-full .cp-preview{position:fixed;z-index:2000;background:var(--black);border:1px solid var(--rule-w);display:flex;flex-direction:column;max-height:80vh}
.cof-partner-full .cp-preview-img{height:200px;position:relative;background:var(--parch,#E8E0D4)}
.cof-partner-full .cp-preview-close{position:absolute;top:16px;right:16px;background:rgba(0,0,0,.5);color:var(--sand);border:none;padding:8px;cursor:pointer;z-index:10}
.cof-partner-full .cp-preview-img-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:rgba(246,241,235,.3)}
.cof-partner-full .cp-preview-body{padding:24px;overflow-y:auto}
.cof-partner-full .cp-preview-body h2{font-size:24px;margin-bottom:8px}
.cof-partner-full .cp-preview-body .desc{font-size:13px;color:var(--sub);margin-bottom:24px}
.cof-partner-full .cp-preview-info{border-top:1px solid var(--rule-w);padding-top:16px;margin-bottom:16px;font-size:12px}
.cof-partner-full .cp-preview-info>div{display:flex;align-items:flex-start;gap:12px;margin-bottom:8px}
.cof-partner-full .cp-preview-info svg{color:var(--clay);margin-top:2px;flex-shrink:0}
.cof-partner-full .cp-preview-info p{color:var(--sand)}
.cof-partner-full .cp-preview-info .sub{color:var(--sub)}
.cof-partner-full .cp-preview-actions{display:flex;gap:8px}
.cof-partner-full .cp-preview-actions .btn{flex:1;text-align:center}

@media(min-width:768px){.cof-partner-full .cp-preview{bottom:32px;right:32px;left:auto;width:420px}}
@media(max-width:767px){.cof-partner-full .cp-preview{bottom:0;left:0;right:0;border-left:0;border-right:0;border-bottom:0;max-height:70vh;width:auto}}
@media(max-width:767px){.cof-partner-full .cp-map-wrap{height:45vh}}

/* Badges */
.cof-partner-full .cp-preview-badges{display:flex;gap:8px;padding:0 24px 8px}
.cof-partner-full .cp-badge{font-family:var(--fl);font-weight:700;font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:3px 8px;border-radius:3px;border:1px solid}
.cof-partner-full .cp-badge-route{color:var(--clay);border-color:var(--clay)}
.cof-partner-full .cp-badge-24h{color:#4ade80;border-color:rgba(74,222,128,.4)}

/* Social footer */
.cof-partner-full .cp-preview-footer{display:flex;gap:1px;border-top:1px solid var(--rule-w);background:var(--rule-w)}
.cof-partner-full .cp-preview-footer .cp-social{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:12px;font-family:var(--fn);font-size:12px;font-weight:600;color:var(--sub);background:var(--black);border:none;cursor:pointer;transition:color .2s;text-decoration:none}
.cof-partner-full .cp-preview-footer .cp-social:hover{color:var(--sand)}

/* Quer ser parceiro */
.cof-partner-full .cp-cta-card{margin-top:8px;padding:24px;text-align:center;border:1px solid var(--rule-w);background:var(--black)}
.cof-partner-full .cp-cta-card h3{font-size:14px;margin-bottom:8px}
.cof-partner-full .cp-cta-card p{font-size:11px;color:var(--sub);margin-bottom:12px}
</style>

{% render 'cofcof-custom-nav', active: 'onde-encontrar' %}

<div class="cp-layout">
  <!-- Left Panel -->
  <div class="cp-panel">
    <div class="cp-header">
      <h1 class="display">{{ heading }}</h1>
      <p class="body-p">{{ text }}</p>

      <div class="cp-search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="cpSearch" placeholder="Busque por cidade, bairro..." aria-label="Buscar parceiros">
        <button class="cp-clear" id="cpSearchClear" aria-label="Limpar busca"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
      </div>

      <div class="cp-filters" id="cpFilters">
        {% for cat in categories %}
          <button data-cat="{{ cat }}"{% if cat == 'Todos' %} class="active"{% endif %}>{{ cat }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cp-list" id="cpList"></div>
    <div class="cp-cta-card" id="cpCTACard">
      <h3 class="display">Quer ser parceiro CofCof?</h3>
      <p class="body-p">Seu estabelecimento pode fazer parte da nossa rede.</p>
      <a href="/pages/empresas" class="btn btn-gh" style="display:inline-block;padding:10px 24px"><span>Saiba mais</span></a>
    </div>
  </div>

  <!-- Map -->
  <div class="cp-map-wrap" id="cpMap">
    <div style="padding:24px;color:rgba(246,241,235,.68)">Carregando mapa...</div>
  </div>
</div>

<!-- Preview -->
<div class="cp-preview" id="cpPreview" hidden>
  <div class="cp-preview-img" id="cpPreviewImg">
    <button class="cp-preview-close" id="cpPreviewClose" aria-label="Fechar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="cp-preview-body">
    <h2 class="display" id="cpPreviewName"></h2>
    <p class="body-p desc" id="cpPreviewDesc"></p>
    <div class="cp-preview-info">
      <div id="cpPreviewAddr">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div><p id="cpPreviewAddrLine"></p><p class="sub" id="cpPreviewAddrSub"></p></div>
      </div>
      <div id="cpPreviewHours">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <p id="cpPreviewHoursText"></p>
      </div>
    </div>
    <div class="cp-preview-badges" id="cpPreviewBadges" hidden>
      <span class="cp-badge cp-badge-route" id="cpBadgeRoute">Rota CofCof</span>
      <span class="cp-badge cp-badge-24h" id="cpBadge24h">24 horas</span>
    </div>
    <div class="cp-preview-actions">
      <a class="btn btn-sd" id="cpPreviewRoute" target="_blank" rel="noopener"><span>Como chegar</span></a>
      <a class="btn btn-gh" id="cpPreviewProfile"><span>Ver perfil &rarr;</span></a>
    </div>
    <div class="cp-preview-footer" id="cpPreviewFooter">
      <a class="cp-social" id="cpSocialInsta" target="_blank" rel="noopener" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        <span>Instagram</span>
      </a>
      <a class="cp-social" id="cpSocialWhats" target="_blank" rel="noopener" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span>WhatsApp</span>
      </a>
      <button class="cp-social" id="cpSocialShare" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        <span>Compartilhar</span>
      </button>
    </div>
  </div>
</div>
</div>

<script id="cpPartnerData" type="application/json">[
{%- assign first_active = true %}
{%- for block in section.blocks %}
  {%- if block.settings.active %}
  {%- unless first_active %},{% endunless %}
  {%- assign first_active = false %}
  {
    "id": {{ block.id | json }},
    "name": {{ block.settings.name | json }},
    "type": {{ block.settings.type | json }},
    "category": {{ block.settings.category | json }},
    "city": {{ block.settings.city | json }},
    "state": {{ block.settings.state | json }},
    "neighborhood": {{ block.settings.neighborhood | json }},
    "address": {{ block.settings.address | json }},
    "lat": {{ block.settings.latitude | default: "" | json }},
    "lng": {{ block.settings.longitude | default: "" | json }},
    "description": {{ block.settings.description | json }},
    "openingHours": {{ block.settings.opening_hours | json }},
    "featured": {{ block.settings.featured | json }},
    "whatsapp": {{ block.settings.whatsapp | json }},
    "instagram": {{ block.settings.instagram | json }},
    "image": {% if block.settings.image %}{{ block.settings.image | image_url: width: 240 | json }}{% else %}""{% endif %},
    "profileUrl": {{ block.settings.profile_url | json }}
  }
  {%- endif %}
{%- endfor %}
]</script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script>window.__cofcofLeafletLoading = true;</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer onload="window.__cofcofLeafletLoading = false;" onerror="console.warn('Leaflet CDN failed to load');window.__cofcofLeafletLoading = false;"></script>
<script src="{{ 'cofcof-partner-map.js' | asset_url }}" defer></script>

