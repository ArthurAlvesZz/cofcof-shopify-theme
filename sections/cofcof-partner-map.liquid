<section class="cof-partner-map-section">
  <div class="cof-partner-map-wrap">
    {% render 'cofcof-custom-nav', active: 'onde-encontrar' %}

    <div class="cof-map-header">
      <p class="cof-kicker">{{ section.settings.kicker }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="cof-map-search">
      <input
        id="cofPartnerSearch"
        type="search"
        placeholder="{{ section.settings.search_placeholder }}"
        aria-label="Buscar parceiros CofCof"
      >
    </div>

    <div class="cof-map-layout">
      <aside class="cof-partner-list" id="cofPartnerList" aria-live="polite"></aside>
      <div class="cof-map-canvas" id="cofPartnerMap">
        <div class="cof-map-fallback">Carregando mapa. Se ele nao aparecer, use a lista de parceiros e o botao Ver rota.</div>
      </div>
    </div>
  </div>
</section>

{{ 'cofcof-partner-map.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
<script src="{{ 'cofcof-partner-map.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Mapa de parceiros CofCof",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Chamada pequena",
      "default": "Onde encontrar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Encontre CofCof perto de voce"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Veja parceiros, cafeterias, emporios e pontos selecionados que revendem CofCof."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder da busca",
      "default": "Buscar por cidade, bairro ou parceiro..."
    }
  ],
  "presets": [
    {
      "name": "Mapa de parceiros CofCof"
    }
  ]
}
{% endschema %}
