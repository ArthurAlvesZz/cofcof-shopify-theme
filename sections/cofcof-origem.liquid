<div class="cof-origem">
<style>
.cof-origem{--black:#0A0A0A;--sand:#F6F1EB;--parch:#E8E0D4;--clay:#7A6654;--sub:#6B6B6B;--dim:#999;--rule:rgba(10,10,10,.12);--rule-w:rgba(246,241,235,.14);--fn:'DM Sans',Helvetica,sans-serif;--fl:'Montserrat',sans-serif;font-family:var(--fn);color:var(--txt);background:var(--sand)}
.cof-origem *{box-sizing:border-box}
.cof-origem a{color:inherit;text-decoration:none}
.cof-origem button{cursor:pointer;border:none;background:none;font:inherit;color:inherit}
.cof-origem .bx{max-width:1340px;margin:0 auto;padding:0 28px}
@media(min-width:768px){.cof-origem .bx{padding:0 56px}}
.cof-origem .fi{opacity:0;transform:translateY(20px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
.cof-origem .fi.v{opacity:1;transform:none}
.cof-origem .eyebrow{font-family:var(--fl);font-weight:700;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--clay)}
.cof-origem .display{font-family:var(--fl);font-weight:800;text-transform:uppercase;letter-spacing:-.01em;line-height:.96}
.cof-origem .ital{font-family:var(--fl);font-weight:800;font-style:italic;text-transform:lowercase;letter-spacing:-.005em;color:var(--clay)}
.cof-origem .body-p{font-family:var(--fn);font-weight:300;line-height:1.65}
.cof-origem .sec{padding:80px 0}
@media(min-width:768px){.cof-origem .sec{padding:112px 0}}
.cof-origem .sec-d{background:var(--black);color:var(--sand)}
.cof-origem .sec-p{background:var(--parch)}
.cof-origem .btn{position:relative;overflow:hidden;display:inline-block;cursor:pointer;font-family:var(--fl);font-weight:700;letter-spacing:.2em;text-transform:uppercase;transition:color .38s;text-align:center}
.cof-origem .btn>span{position:relative;z-index:1}
.cof-origem .btn::before{content:'';position:absolute;inset:0;transform:translateY(101%);transition:transform .42s cubic-bezier(.2,.7,.2,1);z-index:0}
.cof-origem .btn:hover::before{transform:translateY(0)}
.cof-origem .btn-ds{background:var(--black);color:var(--sand)}
.cof-origem .btn-ds::before{background:var(--sand)}
.cof-origem .btn-ds:hover{color:var(--black)}
.cof-origem .btn-sd{background:var(--sand);color:var(--black);border:1.5px solid var(--sand)}
.cof-origem .btn-sd::before{background:var(--black)}
.cof-origem .btn-sd:hover{color:var(--sand)}
.cof-origem .label{font-family:var(--fl);font-weight:700;font-size:11px;letter-spacing:.18em;text-transform:uppercase}

/* Hero */
.cof-origem .pg-hero{padding:130px 0 72px;background:var(--black);color:var(--sand);position:relative;overflow:hidden}
@media(min-width:768px){.cof-origem .pg-hero{padding:160px 0 96px}}
.cof-origem .pg-hero-grid{position:absolute;inset:0;background-image:linear-gradient(to right,var(--rule-w) 1px,transparent 1px);background-size:25% 100%;opacity:.5;pointer-events:none}
.cof-origem .pg-hero-spot{position:absolute;top:-30%;left:50%;transform:translateX(-50%);width:80%;height:70%;background:radial-gradient(ellipse at center,rgba(122,102,84,.16) 0%,transparent 60%);filter:blur(40px);pointer-events:none}
.cof-origem .pg-hero-in{position:relative;z-index:2}
.cof-origem .pg-hero h1{font-size:clamp(2.2rem,5vw,4.2rem);color:var(--sand);font-weight:800;margin-top:20px}
.cof-origem .pg-hero .body-p{font-size:clamp(16px,1.2vw,18px);color:rgba(246,241,235,.7);margin-top:24px}
.cof-origem .pg-hero-cta{margin-top:48px;display:flex;flex-direction:column;gap:16px}
@media(min-width:600px){.cof-origem .pg-hero-cta{flex-direction:row;flex-wrap:wrap}}

/* Hero badge */
.cof-origem .hero-badge{display:inline-flex;align-items:center;border:1px solid rgba(201,162,99,.3);color:var(--clay);padding:6px 16px;border-radius:40px;background:rgba(201,162,99,.05);font-family:var(--fl);font-weight:700;font-size:10px;letter-spacing:.24em;text-transform:uppercase}
.cof-origem .hero-meta{display:flex;flex-wrap:wrap;gap:24px;color:var(--clay);font-family:var(--fl);font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:800;margin-top:40px;justify-content:center}
.cof-origem .hero-meta span{display:flex;align-items:center;gap:6px}

/* Why grid */
.cof-origem .why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2px;background:var(--rule);border:1px solid var(--rule)}
.cof-origem .why-i{background:var(--sand);padding:40px}
.cof-origem .why-i svg{color:var(--clay);margin-bottom:24px}
.cof-origem .why-i h4{font-family:var(--fl);font-weight:800;font-size:24px;color:var(--black);margin-bottom:12px;line-height:.96}
.cof-origem .why-i .label{margin-bottom:24px;font-size:10px}
.cof-origem .why-i p{font-family:var(--fn);font-weight:300;font-size:14px;color:var(--sub);line-height:1.65}

/* Map section */
.cof-origem .orig-map-wrap{padding:0;position:relative;background:var(--black);border:1px solid var(--rule-w);overflow:hidden}
.cof-origem .orig-map-flex{display:flex;flex-direction:column;height:100%}
@media(min-width:1024px){.cof-origem .orig-map-flex{flex-direction:row}}
.cof-origem .orig-map-panel{padding:clamp(32px,4vw,64px);background:var(--black)}
@media(min-width:1024px){.cof-origem .orig-map-panel{flex:1;border-right:1px solid var(--rule-w)}}
.cof-origem .orig-map-filter{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.cof-origem .orig-filter-btn{padding:6px 12px;border-radius:40px;font-family:var(--fl);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;border:1px solid var(--rule-w);background:var(--black);color:var(--clay);transition:all .2s}
.cof-origem .orig-farm-card{border:1px solid var(--rule-w);background:var(--black);padding:24px;display:flex;flex-direction:column;margin-bottom:16px}
.cof-origem .orig-farm-card.selected{border-color:var(--clay)}
.cof-origem .farm-detail-row{display:flex;justify-content:space-between;border-bottom:1px solid var(--rule);padding:12px 0;font-size:14px}
.cof-origem .farm-detail-row:first-of-type{padding-top:0}
.cof-origem .farm-detail-key{color:var(--sub)}
.cof-origem .farm-detail-val{color:var(--sand)}
.cof-origem .farm-detail-val.highlight{color:var(--clay);font-weight:700}
.cof-origem .orig-map-placeholder{flex:1;min-height:400px;background:#1a1a1a;position:relative;overflow:hidden}
@media(min-width:1024px){.cof-origem .orig-map-placeholder{min-height:500px}}
.cof-origem .map-grid-overlay{position:absolute;inset:0;background-image:linear-gradient(to right,var(--rule-w) 1px,transparent 1px),linear-gradient(to bottom,var(--rule-w) 1px,transparent 1px);background-size:8.33% 8.33%;opacity:.3}
.cof-origem .map-pin{position:absolute;width:32px;height:32px;border-radius:50%;border:2px solid var(--clay);display:flex;align-items:center;justify-content:center;color:var(--clay);transform:translate(-50%,-50%);transition:all .3s;cursor:default;z-index:2}
.cof-origem .map-pin.featured{background:var(--clay);color:var(--black)}
.cof-origem .map-pin.premium{border-color:var(--clay);background:transparent}
.cof-origem .map-pin-label{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:4px;font-family:var(--fl);font-size:7px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(246,241,235,.6);white-space:nowrap;text-shadow:0 0 4px #000}

/* Producers */
.cof-origem .prod-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:2px;background:var(--rule);border:1px solid var(--rule)}
.cof-origem .prod-i{display:flex;flex-direction:column;background:var(--sand)}
.cof-origem .prod-img{aspect-ratio:4/3;position:relative;overflow:hidden;background:var(--parch);display:flex;align-items:center;justify-content:center}
.cof-origem .prod-img svg{opacity:.1}
.cof-origem .prod-body{padding:32px;display:flex;flex-direction:column;flex:1}
.cof-origem .prod-name{font-family:var(--fl);font-weight:800;font-size:24px;color:var(--black);margin-bottom:8px;line-height:.96}
.cof-origem .prod-loc{font-family:var(--fn);font-weight:300;font-size:12px;color:var(--sub);margin-bottom:24px}
.cof-origem .prod-details{border-top:1px solid var(--rule);padding-top:24px;display:flex;flex-direction:column;gap:8px;font-size:13px;margin-bottom:32px}
.cof-origem .prod-details>div{display:flex;justify-content:space-between}
.cof-origem .prod-details .key{color:var(--sub)}
.cof-origem .prod-details .val{color:var(--black)}
.cof-origem .prod-details .val.gold{color:var(--clay);font-weight:700}
.cof-origem .prod-actions{display:flex;gap:16px;margin-top:auto}
.cof-origem .prod-actions .btn{flex:1;padding:16px;font-size:10px;text-align:center}

/* Timeline */
.cof-origem .tl-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;text-align:center}
.cof-origem .tl-i{}
.cof-origem .tl-circle{width:80px;height:80px;border-radius:50%;background:var(--black);border:1px solid var(--rule-w);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;color:var(--clay)}
.cof-origem .tl-i h4{font-family:var(--fl);font-weight:800;font-size:20px;color:var(--sand);margin-bottom:8px;line-height:.96}
.cof-origem .tl-i p{font-family:var(--fn);font-weight:300;font-size:12px;color:rgba(246,241,235,.6);line-height:1.65}

/* Products grid (light variant) */
.cof-origem .prd-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2px;background:var(--rule-w);border:1px solid var(--rule-w);margin-top:0}
.cof-origem .prd-i{background:var(--parch);padding:32px;display:flex;flex-direction:column;transition:background .3s}
.cof-origem .prd-i:hover{background:#ddd5c9}
.cof-origem .prd-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}
.cof-origem .prd-reg{font-family:var(--fl);font-weight:700;font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--clay);border:1px solid rgba(10,10,10,.2);padding:4px 10px;border-radius:4px}
.cof-origem .prd-badge{font-family:var(--fl);font-weight:700;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--sand);background:var(--clay);padding:4px 8px;border-radius:4px}
.cof-origem .prd-t{font-family:var(--fl);font-weight:800;font-size:24px;color:var(--black);margin-bottom:8px;line-height:.96}
.cof-origem .prd-n{font-family:var(--fn);font-weight:300;font-size:14px;color:var(--sub);line-height:1.5;margin-bottom:32px}
.cof-origem .prd-b{margin-top:auto;display:flex;justify-content:space-between;align-items:center}
.cof-origem .prd-pr{font-family:var(--fl);font-weight:700;font-size:16px;color:var(--black)}
.cof-origem .prd-lnk{font-family:var(--fl);font-weight:700;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--clay)}

/* Head section */
.cof-origem .head{display:flex;flex-direction:column;gap:32px;margin-bottom:64px}
@media(min-width:768px){.cof-origem .head{flex-direction:row;justify-content:space-between;align-items:flex-end}}
</style>

{% render 'cofcof-custom-nav', active: 'origem' %}

<!-- HERO -->
