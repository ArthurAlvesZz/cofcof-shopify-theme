        <div style="display:flex;gap:16px;margin-top:24px">
          <a href="/cafes/lote-01-paraiso" class="btn btn-sd" style="flex:1;text-align:center;font-size:10px"><span>Ver Cafe do Lote</span></a>
          <a href="#produtores" class="btn btn-ds" style="flex:1;border:1px solid var(--rule-w);font-size:10px;text-align:center"><span>Ver Produtor</span></a>
        </div>
      </div>

      <!-- Farm 2 -->
      <div class="orig-farm-card">
        <div style="margin-bottom:24px">
          <h3 class="display" style="font-size:24px;color:var(--sand)">Sitio Bela Vista</h3>
          <p class="body-p" style="font-size:14px;color:var(--sub)">Produtor: Roberto Silva</p>
        </div>
        <div class="farm-detail-row"><span class="farm-detail-key">Altitude</span><span class="farm-detail-val">1180m</span></div>
        <div class="farm-detail-row"><span class="farm-detail-key">Processo</span><span class="farm-detail-val">Natural</span></div>
        <div class="farm-detail-row"><span class="farm-detail-key">Pontuacao</span><span class="farm-detail-val highlight">88.0 SCA</span></div>
        <div style="display:flex;gap:16px;margin-top:24px">
          <a href="/cafes/lote-02-topazio" class="btn btn-sd" style="flex:1;text-align:center;font-size:10px"><span>Ver Cafe do Lote</span></a>
          <a href="#produtores" class="btn btn-ds" style="flex:1;border:1px solid var(--rule-w);font-size:10px;text-align:center"><span>Ver Produtor</span></a>
        </div>
      </div>

      <!-- Farm 3 -->
      <div class="orig-farm-card">
